#!/usr/bin/env zsh
set -euo pipefail

if (( $# != 3 )); then
  echo "usage: scripts/gema-session <name> <model> <effort>" >&2
  exit 64
fi

name="$1"
model="$2"
effort="$3"
repo="${0:A:h:h}"
worktree="${repo:h}/gema-$name"

if [[ ! -d "$worktree" ]]; then
  git -C "$repo" fetch -q origin
  git -C "$repo" worktree add --detach "$worktree" origin/main
fi

cd "$worktree"
exec claude -n "$name" --model "$model" --effort "$effort" --permission-mode bypassPermissions
